# 複製成 repo 根目錄的 .env；所有祕密欄位刻意留白。
# 路徑與 HTTP 設定（資料庫與匯出分開存放）
DATABASE_PATH=
EXPORT_ROOT=
# 單一後端程序定期更新 Markdown；測試環境可關閉。
EXPORT_WORKER_ENABLED=true
LOG_PATH=
# 精確允許來源，可用逗號分隔，例如本機 + https://裝置.網路.ts.net。
APP_ORIGIN=http://127.0.0.1:8000
ALLOWED_HOSTS=["127.0.0.1","localhost"]
# 有 HTTPS 來源時設 true；明列的 loopback HTTP 仍使用自己的非 Secure cookie。
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
# 只給測試／驗收資料使用（帳號固定為 admin、marketing_test、viewer_test），正式環境不會讀取。
# 正式環境的第一個管理員請用 set_password.py --create-admin 建立，帳號名稱自訂、密碼在終端機輸入（見 README）。
# 留白的測試帳號不可登入；只在首次初始化時套用，不會覆寫既有密碼。
ADMIN_INITIAL_PASSWORD=
MARKETING_TEST_INITIAL_PASSWORD=
VIEWER_TEST_INITIAL_PASSWORD=

# 後端 ingest 與平台測試帳號（正式帳號需明確授權）
# prepare 會安全產生 INGEST_API_KEY；留白時 Ingest API 一律回 401。
INGEST_API_KEY=
INGEST_MAX_BYTES=2097152
# AI UI 金鑰的 Fernet 主金鑰；用 scripts/initialize_ai_encryption.py 安全初始化，請另行保存。
ACCOUNT_ENCRYPTION_KEY=
# 僅供已停用的 LINE inbound 端點驗簽並丟棄；不讀取資料庫舊憑證。
LINE_CHANNEL_SECRET=
META_APP_ID=
# YouTube OAuth：用戶端 ID／密鑰可由管理員在平台連線頁加密儲存；權杖由連結流程寫入（讀取＋上傳影片）。
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
# TikTok for Developers 的 Sandbox 金鑰通常在平台連線卡片設定；權杖由連結流程寫入。
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OPEN_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# 僅供初始化：用戶權杖用來取得指定測試粉專的權杖，不交給 ngrok。
META_USER_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
# Meta App 審核通過且 IG 留言 Webhook 實收驗證後才改 true，補抓改為每小時對帳。
META_IG_COMMENTS_WEBHOOK_LIVE=false
# 本機所有排程共用的保守呼叫預算；不是 Meta 官方保證額度，仍遵從用量標頭降頻。
META_API_CALLS_PER_HOUR=180
# 留言讀取由單篇按鈕觸發，固定最近 90 天；舊自動範圍設定會忽略。
# 同一私訊 messages 游標連續逾時／5xx 上限；達上限保留部分未完成說明。
WEBHOOK_PUBLIC_URL=
# 發佈媒體預設 data/publish-media；隔離測試必須指定 .runtime 目錄。
PUBLISH_MEDIA_ROOT=
PUBLISH_POLL_SECONDS=5
PUBLISH_POLL_TIMEOUT=300
# 只需提供這個外部憑證；固定網址由 ngrok 免費帳號指派並在首次啟動後保存。
NGROK_AUTHTOKEN=
# prepare 只初始化探測金鑰，不修改平台憑證或送出開關。
WEBHOOK_PROBE_SECRET=
GATEWAY_STARTUP_TIMEOUT_SECONDS=120
SCHEDULER_ENABLED=true
SCHEDULER_CLASSIFY_ENABLED=true
SCHEDULER_NOTIFY_ENABLED=true
# 僅執行按鈕建立的單篇一次性留言工作，無自動輪詢。
SCHEDULER_COMMENTS_ENABLED=true
SCHEDULER_METRICS_ENABLED=true
SCHEDULER_IDEATION_ENABLED=true
SCHEDULER_PUBLISH_ENABLED=true
COMMENTS_WAKE_ENABLED=true

# 模型與執行方式；背景任務僅允許 API。
JEV_API_KEY=
JEV_API_BASE_URL=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
OPENAI_MODEL=
# API 草稿可依使用者需求選擇模型供應商。
# 僅由後端讀取；模型填入帳號可用的正式 model ID，不使用 VITE_ 前綴。
GEMINI_API_KEY=
GEMINI_MODEL=
# 免費方案的內容會被 Google 用於改善產品，工作檯不讓它處理平台資料；Cloud 專案綁定帳單後才設 true。
GEMINI_PAID_TIER=false
# 他人留言的保留天數（30–3650）；每日排程刪除到期留言，報告只移除引用原文。
COMMENT_RETENTION_DAYS=365
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_API_TIMEOUT_SECONDS=60
# 一般文字模型輸出上限；第 3 階段報告／腳本固定使用 8192，避免長 JSON 截斷
AI_MAX_OUTPUT_TOKENS=2048
AI_MONTHLY_BUDGET_USD=

# 獨立的通知測試帳號與群組
NOTIFY_LINE_CHANNEL_ACCESS_TOKEN=
NOTIFY_LINE_CHANNEL_SECRET=
NOTIFY_LINE_BOT_USER_ID=
# 系統警示預設收件對象；品牌通知群組在工作區設定個別指定。
NOTIFY_LINE_GROUP_ID=
# 後端監聽位址；改埠號時 APP_ORIGIN 的本機網址要一起改（見 docs/operations.md「改用其他連接埠」）。
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# 目的地內建立 marketing-workbench 子資料夾，兩邊各保留最近 14 份加密備份。
# Google Drive 串流磁碟需要 Windows 使用者與 Drive 電腦版保持登入。
BACKUP_LOCAL_ROOT=
BACKUP_DRIVE_ROOT=
BACKUP_PASSWORD=
# 留白使用 C:/Program Files/7-Zip/7z.exe；密碼僅經標準輸入，不出現在程序參數。
SEVEN_ZIP_PATH=
# T1-14：登入後執行 node scripts/tailscale.mjs configure 自動填妥 HTTPS 來源與主機。
TAILSCALE_ENABLED=false

# ngrok 搜尋順序：PATH、此完整路徑、%LOCALAPPDATA%\ngrok\bin\ngrok.exe
NGROK_PATH=
# 後端每五分鐘收訊健康監測；無人值守警示直接使用通知用 LINE API
RECEIVE_HEALTH_WORKER_ENABLED=true
RECEIVE_HEALTH_ALERTS_ENABLED=true

# MCP 可由環境變數、.env 或 CLI 參數指定；新前綴優先。

# 額外禁止匯出／備份的路徑，JSON 絕對路徑陣列。
PROTECTED_PATHS=[]

# 平台帳號登記工具的目標品牌 slug，亦可傳 --brand；留白會要求明確指定。
REGISTRATION_BRAND_SLUG=
OBSIDIAN_ROOT=

# 維護者開源前掃描用（scripts/release_scan.py）：不能出現在公開版的私人字詞，逗號分隔，例如本名、舊帳號名稱。
RELEASE_PRIVATE_TERMS=
# 刻意公開的字詞或信箱（例如品牌帳號、README 的聯絡信箱），逗號分隔；完全相同的值不列為洩漏。
RELEASE_PUBLIC_TERMS=
